{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mobile: Chrome",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    },
    {
      "name": "Mobile: Android emulator",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define=FF_API_URL=http://10.0.2.2:8000"]
    },
    {
      "name": "Mobile: Physical phone (USB)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/mobile",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define=FF_API_URL=http://192.168.0.100:8000"]
    },
    {
      "name": "Backend: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "jinja": true,
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full stack: Backend + Chrome",
      "configurations": ["Backend: FastAPI (uvicorn)", "Mobile: Chrome"],
      "stopAll": true
    }
  ]
}
