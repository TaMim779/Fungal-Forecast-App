{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: setup venv",
      "type": "shell",
      "command": "python -m venv .venv; .\\.venv\\Scripts\\python.exe -m pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: run API (uvicorn :8000)",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Backend: pytest",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m pytest -q",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Backend: seed demo data",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe scripts/seed_demo.py",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Mobile: flutter pub get",
      "type": "shell",
      "command": "flutter pub get",
      "options": { "cwd": "${workspaceFolder}/mobile" },
      "problemMatcher": []
    },
    {
      "label": "Mobile: flutter test",
      "type": "shell",
      "command": "flutter test",
      "options": { "cwd": "${workspaceFolder}/mobile" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Mobile: flutter analyze",
      "type": "shell",
      "command": "flutter analyze",
      "options": { "cwd": "${workspaceFolder}/mobile" },
      "problemMatcher": []
    },
    {
      "label": "Mobile: build web (release)",
      "type": "shell",
      "command": "flutter build web --release",
      "options": { "cwd": "${workspaceFolder}/mobile" },
      "problemMatcher": []
    }
  ]
}
