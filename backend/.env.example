# Copy to .env (or set in your shell) to override defaults.

# SQLite file (default: backend/fungalforecast.db)
# FF_DATABASE_PATH=D:/FungalForecast/backend/fungalforecast.db

# Weather provider: open-meteo (live, free, no key) | mock (offline, deterministic)
FF_WEATHER_PROVIDER=open-meteo
FF_WEATHER_TIMEOUT=6

# Predictions below this confidence go to the agronomist queue
FF_AGRONOMIST_THRESHOLD=0.70

# Community outbreak alerts
FF_OUTBREAK_RADIUS_KM=10
FF_OUTBREAK_WINDOW_DAYS=14

FF_DEBUG=false
